# Mandate MCP server.
#
# The stdio transport is spawned by each MCP client, which means no client that can only reach a
# network endpoint can use it. This image runs the same server over Streamable HTTP so it can be
# hosted once and shared, and so a deployment can be health-checked by a platform rather than by a
# person running the tools.
#
# The image carries no key. MANDATE_API_KEY and MANDATE_API_BASE must be injected at run time: a
# credential baked into a layer would be readable by anyone who can pull the image.

FROM node:22-alpine

# tini reaps zombies and forwards signals, so SIGTERM reaches node and the process exits cleanly
# instead of waiting out the orchestrator's kill timeout.
RUN apk add --no-cache tini

WORKDIR /app

# No package install: mcp/server.mjs imports only node:crypto and node:readline, so the image needs
# no dependencies at all. That is the point of the stdio design - a client can spawn it with node and
# nothing else. Adding an install here would be pure attack surface and image size, and would risk
# pulling in the dashboard's native deps (libsql) that this server never loads.
COPY mcp/ ./mcp/

# Unprivileged: nothing here needs root, and a spending server should not have it.
USER node

ENV NODE_ENV=production \
    MANDATE_MCP_TRANSPORT=http \
    MANDATE_MCP_PORT=8787 \
    MANDATE_API_BASE=http://localhost:3000

EXPOSE 8787

# The orchestrator should restart on a missing key or a crash, not route traffic to a dead server.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.MANDATE_MCP_PORT||8787)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/sbin/tini", "--", "node", "mcp/server.mjs"]