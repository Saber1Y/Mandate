# --- Mandate on BOT Chain Bohr Testnet (chain id 968) ---
# See web/lib/bot.ts for the canonical values; these vars only override the defaults.
NEXT_PUBLIC_BOT_RPC_URL=https://rpc.bohr.life
NEXT_PUBLIC_BOT_EXPLORER_URL=https://scan.bohr.life

# Deployed Mandate contracts. Never hardcode an address in source: an unset value throws
# MissingMandateConfigError rather than silently pointing at the wrong contract.
# Deploy with:
#   forge script script/DeployMandateFactory.s.sol --rpc-url https://rpc.bohr.life --broadcast
#   forge script script/DeployMandateVault.s.sol   --rpc-url https://rpc.bohr.life --broadcast
NEXT_PUBLIC_MANDATE_FACTORY_ADDRESS=
NEXT_PUBLIC_MANDATE_VAULT_ADDRESS=

# tUSDT is fixed at 0x75edC9335175Fc0552D51D48439F229c10420fe3 with 6 decimals (see web/lib/bot.ts).

# --- Legacy SpendArc on Arc Testnet (chain id 5042002) ---
# DEPRECATED: the frontend still builds against these until the Mandate ABI rollout lands.
# Remove this block together with web/lib/arc.ts and the SpendArc routes.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_VAULT_ADDRESS=0x0b860c25Dc6b2Df451AA66cFCdc7D6c6D7802F66

# Privy auth (https://dashboard.privy.io)
# Pending decision: keep Privy, or replace with the ERC-4337 organization smart account.
NEXT_PUBLIC_PRIVY_APP_ID=

# Server-side keys. The platform must NOT hold vault owner authority:
# the owner is an org-controlled ERC-4337 account or multisig. Only the gas-only executor key
# belongs here, and it must never be able to approve, change policy, or withdraw.
EXECUTOR_PRIVATE_KEY=
VAULT_OWNER_PRIVATE_KEY=

# QA agent runner (npm run qa:agent)
AGENT_MODEL=opencode/deepseek-v4-flash-free
AGENT_API_BASE=http://localhost:3000

# Turso/libSQL (required for Vercel - local SQLite cannot persist there)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=