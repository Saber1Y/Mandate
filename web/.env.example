# --- Mandate on BOT Chain Bohr Testnet (chain id 968) ---
# Canonical values live in web/lib/bot.ts; these vars only override the defaults.
NEXT_PUBLIC_BOT_RPC_URL=https://rpc.bohr.life
NEXT_PUBLIC_BOT_EXPLORER_URL=https://scan.bohr.life

# Deployed Mandate contracts. Never hardcode an address in source: an unset value throws
# MissingMandateConfigError rather than silently pointing at the wrong contract.
# Deploy with:
#   forge script script/DeployMandateFactory.s.sol --rpc-url https://rpc.bohr.life --broadcast
#   forge script script/DeployMandateVault.s.sol   --rpc-url https://rpc.bohr.life --broadcast
NEXT_PUBLIC_MANDATE_FACTORY_ADDRESS=0xcc9eAfFA4AB9108eB4E66952c420630D6340A719
NEXT_PUBLIC_MANDATE_VAULT_ADDRESS=0x45672a2cC6dfA5b975A6DBC5638C0154c01C85Be

# tUSDT is fixed at 0x75edC9335175Fc0552D51D48439F229c10420fe3 with 6 decimals (see web/lib/bot.ts).

# Privy auth (https://dashboard.privy.io)
# Owner's on-chain address is read from the vault, not trusted from the client, so the app ID only
# controls login UX. Replace Privy with an org smart account for production.
NEXT_PUBLIC_PRIVY_APP_ID=

# Server-side key. The platform must NOT hold vault owner authority: the owner is an org-controlled
# smart account or multisig. Only a gas-only executor key belongs here, and it must never be able to
# approve, change policy, or withdraw. The server refuses to relay if the key is not registered as an
# executor on the deployed vault.
EXECUTOR_PRIVATE_KEY=

# Credential DB. Local SQLite (web/data/mandate.db) is used when unset. Vercel needs Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Live API QA runner (npm run qa:agent -- --api-key mdt_...)
AGENT_API_BASE=http://localhost:3000
# Allowlisted recipient address, required only for --settle.
QA_RECIPIENT=